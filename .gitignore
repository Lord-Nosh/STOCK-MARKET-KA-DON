# Node / npm / pnpm
node_modules/
.pnpm-store/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
venv/
ENV/
.venv/

# Environment and sensitive keys
.env
.env.*
!.env.example
*.pem
*.key

# IDE / OS files
.DS_Store
Thumbs.db
.vscode/
.idea/

# Runtime SQLite databases and sidecar files (never commit user/runtime data)
stock-signal-bot/backend/app/data/*.db
stock-signal-bot/backend/app/data/*.db-shm
stock-signal-bot/backend/app/data/*.db-wal

# Generated backups and manifests (never commit local paths or runtime snapshots)
stock-signal-bot/backend/app/backups/*
!stock-signal-bot/backend/app/backups/.gitkeep

# Runtime diagnostics (generated logs, crash bundles)
.runtime/
