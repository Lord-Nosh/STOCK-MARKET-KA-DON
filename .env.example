# Copy to .env locally; never commit real credentials.
# The application currently uses an unverified public market-data endpoint.
# This setting does not make the feed authoritative or execution-eligible.
SMKD_DATA_MODE=live

# Comma-separated exact frontend origins. Do not use wildcard origins in production.
SMKD_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,https://localhost,capacitor://localhost

# Required for administrative backup/feed-health endpoints. Generate a unique secret.
# When unset, these endpoints are disabled (HTTP 503).
SMKD_ADMIN_API_KEY=replace-with-a-long-random-secret

# Local dev defaults. Set reload=true only on a trusted development machine.
SMKD_HOST=127.0.0.1
SMKD_PORT=8000
SMKD_RELOAD=false
